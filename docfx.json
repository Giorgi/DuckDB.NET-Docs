{
  "metadata": [
    {
      "src": [
        {
          "src": "../DuckDB.NET",
          "files": [
            "**/Bindings.csproj",
            "**/Data.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "docs/**/*.{md,yml}",
          "api/**/*.yml",
          "toc.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "my-template"
    ],
    "sitemap": {
      "baseUrl": "https://duckdb.net"
    },
    "globalMetadata": {
      "_appName": "DuckDB.NET",
      "_appTitle": "DuckDB.NET",
      "_appFooter": "© Giorgi Dalakishvili · <a href=\"https://github.com/Giorgi/DuckDB.NET/blob/develop/LICENSE.md\">MIT License</a> · <a href=\"https://github.com/Giorgi/DuckDB.NET\">GitHub</a> · <a href=\"https://www.nuget.org/packages/DuckDB.NET.Data.Full\">NuGet</a>",
      "_enableSearch": true,
      "pdf": false
    }
  }
}